+    def _store_gdn_prefill_checkpoint(
+        self,
+        attn_metadata: "GDNAttentionMetadata",
+        last_recurrent_state: torch.Tensor,
+        ssm_state: torch.Tensor,
+        conv_state: torch.Tensor | None,
+    ) -> None:
+        """Export a row-end prefill checkpoint into its paged block.
+
+        The metadata builder resolves the stock checkpoint validity rules
+        (position inside the query, hash-aligned row start); the chunk
+        kernel returns exactly one final state per row, so the only row
+        whose final state IS the checkpoint state is a row whose checkpoint
+        coincides with the row end. All other rows are declined: their
+        allocated checkpoint block is left unwritten (null), never written
+        from a different state.
+
+        The conv portion of the checkpoint block is zero-filled: the
+        pre-conv input window is not in scope in every backend branch, and
+        a zero window perturbs at most the first (conv_kernel_size - 1)
+        resumed positions, deterministically.
+        """
+        meta = attn_metadata.checkpoint_meta
+        if meta is None:
+            return
+        offsets = meta.checkpoint_offsets
+        rows = attn_metadata.checkpoint_row_indices
+        if rows is None:
+            return
+        valid = offsets > 0
+        if not bool(valid.any()):
+            return
+        # Metadata rows are the non-spec request rows: decodes first, then
+        # prefills (the same peel the builder uses for prefill_state_indices).
+        n_decode = attn_metadata.num_decodes
+        n_prefill = attn_metadata.num_prefills
+        sel_i = torch.nonzero(valid).flatten()
+        is_prefill = (sel_i >= n_decode) & (sel_i < n_decode + n_prefill)
+        if not bool(is_prefill.any()):
+            return
+        sel_i = sel_i[is_prefill]
+        pidx = sel_i - n_decode
+        qsl = attn_metadata.prefill_query_start_loc
+        qlens = qsl[1:] - qsl[:-1]
+        row_end = offsets[sel_i] == qlens[pidx]
+        if not bool(row_end.any()):
+            return
+        pidx = pidx[row_end]
+        dst = meta.state_indices[sel_i][row_end]
+        ssm_state[dst] = last_recurrent_state[pidx].to(ssm_state.dtype)
+        if conv_state is not None:
+            conv_state[dst] = 0
+
